{
  "manifest_version": 3,
  "name": "Inbox Mail Grabber",
  "version": "1.0",
  "description": "Silently captures the temporary email address from the inbox page.",
  "permissions": ["scripting","tabs","storage"],
  "host_permissions": ["*://temp-mail.org/*"],
  "content_scripts": [
    {
      "matches": ["*://temp-mail.org/*","*://*.temp-mail.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inbox Mail Grabber",
    "default_icon": {
      "48": "icon.svg",
      "96": "icon.svg"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "inbox-grabber@example.com",
      "strict_min_version": "109.0"
    }
  }
}
